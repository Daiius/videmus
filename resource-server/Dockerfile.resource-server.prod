FROM node:24-trixie-slim AS build

WORKDIR /workspace/resource-server

RUN corepack enable && corepack prepare pnpm@12.15.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml /workspace/
COPY ./resource-server/package.json /workspace/resource-server/
COPY ./database/package.json /workspace/database/

RUN pnpm install --filter videmus-resource-server --filter videmus-database

COPY ./resource-server/src/ /workspace/resource-server/src/
COPY ./database/db/ /workspace/database/db/
COPY ./resource-server/tsconfig.json ./resource-server/esbuild.config.ts /workspace/resource-server/

RUN pnpm build


FROM gcr.io/distroless/nodejs24-debian13:debug

WORKDIR /workspace/resource-server

COPY ./resource-server/package.json ./
COPY --from=build /workspace/resource-server/dist/server.js /workspace/resource-server/server.js

# ビルドの版（prd/05 §4）。`GET /version` が返す。`.dockerignore` が `.git` を除くので
# イメージの中では git から取れない——ビルド引数で渡す。未指定なら unknown（ビルドは止めない）。
#   --build-arg GIT_COMMIT=$(git rev-parse HEAD)
#   --build-arg BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ)
#   --build-arg GIT_DIRTY=false
# 最終ステージの末尾に置く（値が毎回変わるので、手前の層のキャッシュを壊さないように）。
# 渡し忘れは src/lib/buildVersion.test.ts が照合する。
ARG GIT_COMMIT=unknown
ARG BUILD_TIME=unknown
ARG GIT_DIRTY=false
ENV GIT_COMMIT=$GIT_COMMIT BUILD_TIME=$BUILD_TIME GIT_DIRTY=$GIT_DIRTY

CMD ["server.js"]
